# Nunca compartas este archivo con el token real.
DISCORD_TOKEN=pega_aqui_el_token_del_bot
CLIENT_ID=pega_aqui_el_id_de_la_aplicacion
# Opcional: permite registrar /help solo en un servidor durante las pruebas.
GUILD_ID=id_de_tu_servidor
# Necesario para buscar personas por nombre (por ejemplo, `xyb kiss csr`).
# Actívalo también en Discord Developer Portal > Bot > Server Members Intent.
MEMBERS_INTENT=false

# Música: YouTube como fuente principal y SoundCloud como respaldo.
# No usa cookies, datos del navegador, Lavalink ni credenciales de Spotify.
MUSIC_BITRATE=64
MUSIC_VOLUME=100
# Servicio PO Token de bgutil en la red privada de Railway. Es lo que permite
# que YouTube entregue audio desde una IP de datacenter sin cookies.
YTDLP_POT_PROVIDER_URL=http://pot-provider.railway.internal:4416
# Opcional: ruta del plugin PO Token dentro del contenedor.
# YTDLP_PLUGIN_DIR=/opt/yt-dlp-plugins
# Opcional: clientes de YouTube que usa yt-dlp (en ese orden).
# YOUTUBE_CLIENTS=mweb,web_embedded,android
# Opcional: país de iTunes para los metadatos (US, MX, ES...).
# ITUNES_COUNTRY=US
# Opcional: rutas propias de yt-dlp, FFmpeg y Python.
# YTDLP_PATH=C:\ruta\a\yt-dlp.exe
# FFMPEG_PATH=C:\ruta\a\ffmpeg.exe
# YTMUSIC_PYTHON=C:\ruta\a\python.exe
# Metadatos de MusicBrainz.
# MB_APP_NAME=xyb-private-bot
# MB_APP_VERSION=1.0.0
# MB_CONTACT=https://github.com/tu-usuario/tu-repo

# Opcional: proveedor SFW de GIF para las interacciones (hug, slap, hi...).
# Si no responde, el bot usa una lista local de respaldo.
# INTERACTION_GIF_API=https://api.otakugifs.xyz/gif

# Etiqueta obligatoria: servidor exacto que se revisa y cuya etiqueta se exige.
TAG_ENFORCEMENT_ENABLED=false
TAG_GUILD_ID=
# Canal general para el aviso obligatorio 20 minutos antes del ban.
TAG_WARNING_CHANNEL_ID=
